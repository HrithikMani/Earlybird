          { "strategy": "playwright", "notes": "SPA search box + Newest sort + Load more", "rule": { "type": "browser", "item_selector": ".card", "search": { "mode": "per_term" }, "sorted_newest_first": true, "fast_max_pages": 1, "actions": [{ "do": "goto", "url": "{{portal}}/spa/acme" }, { "do": "wait", "selector": ".card" }, { "do": "fill", "selector": "#search", "value": "{{query}}" }, { "do": "select", "selector": "#sort", "value": "newest" }, { "do": "click", "selector": "#more", "repeat_until_gone": true }, { "do": "extract" }], "fields": { "id": "@data-id", "title": "h3 a", "url": "h3 a@href", "location": ".location", "posted_at": ".posted" } } }
        ],
