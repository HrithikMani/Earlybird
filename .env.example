# Optional. Earlybird boots without a .env; everything else is configured in the dashboard (Settings).
PORT=3000

# Network access. 127.0.0.1 = only this computer (default). 0.0.0.0 = other devices on your network too.
# HOST=0.0.0.0
# Dashboard login (login page + session cookie). Enabled when a password is set; without one, anyone on the
# network can use the dashboard. This computer skips the login unless EARLYBIRD_AUTH_LOCAL=1.
# EARLYBIRD_USERNAME=admin
# EARLYBIRD_PASSWORD=
# EARLYBIRD_AUTH_LOCAL=1

# DATA_DIR=./data
# LOG_LEVEL=info
# Only used if no API key is saved in Settings → AI.
# ANTHROPIC_API_KEY=
