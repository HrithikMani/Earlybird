# Optional. Earlybird boots without a .env; everything else is configured in the dashboard (Settings).
PORT=3000

# Network access. 127.0.0.1 = only this computer (default). 0.0.0.0 = other devices on your network too.
# HOST=0.0.0.0
# Optional password other devices must enter (any username). Without it, anyone on the network can use the dashboard. This computer never needs it.
# EARLYBIRD_PASSWORD=

# DATA_DIR=./data
# LOG_LEVEL=info
# Only used if no API key is saved in Settings → AI.
# ANTHROPIC_API_KEY=
