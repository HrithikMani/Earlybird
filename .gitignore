# =====================================================================
# Earlybird .gitignore
# Commit: source, prompts, tests, fixtures, migrations, setup scripts,
#         package-lock.json, .env.example, .vscode/mcp.json, .github/.
# Never commit: secrets, local data, build output, test output, caches.
# =====================================================================

# --- Dependencies ------------------------------------------------------
node_modules/

# --- Secrets / local config --------------------------------------------
# .env holds the API key and the network password.
.env
.env.*
!.env.example
*.pem
*.key

# --- Earlybird runtime data ---------------------------------------------
# SQLite DB, rotating logs, screenshots/HTML/traces of failed runs,
# AI-generated script rules, CLI drafts.
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Browser automation output -------------------------------------------
# Playwright MCP snapshots, and pages an agent saved while exploring.
.playwright-mcp/
/*.html
*.har
*-trace.zip
trace.zip

# --- Build output ---------------------------------------------------------
web/dist/
dist/
build/
*.tsbuildinfo

# --- Tests ----------------------------------------------------------------
e2e/report/
e2e/test-results/
test-results/
playwright-report/
blob-report/
playwright/.cache/
coverage/

# --- Logs -------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Caches -----------------------------------------------------------------
.cache/
.eslintcache
.npm/
.vite/
.vitest/
.turbo/

# --- OS / editor -----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/mcp.json
!.vscode/extensions.json
