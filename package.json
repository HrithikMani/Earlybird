{
  "name": "earlybird",
  "version": "0.1.0",
  "private": true,
  "description": "Watches company career portals and posts new jobs to Discord within minutes.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev": "node scripts/preflight.mjs && node --watch --watch-preserve-output src/main.js",
    "build": "vite build",
    "start": "node scripts/preflight.mjs && node src/main.js --prod",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c e2e/playwright.config.js",
    "test:e2e:ui": "playwright test -c e2e/playwright.config.js --ui",
    "test:e2e:headed": "playwright test -c e2e/playwright.config.js --headed",
    "test:e2e:debug": "playwright test -c e2e/playwright.config.js --debug",
    "test:e2e:live": "node scripts/run-live-e2e.mjs",
    "test:all": "vitest run && playwright test -c e2e/playwright.config.js",
    "test:report": "playwright show-report e2e/report",
    "eb": "node src/cli/eb.js",
    "verify": "node src/cli/eb.js verify run",
    "rule": "node src/cli/eb.js rule run",
    "db:generate": "drizzle-kit generate",
    "test:replay": "node scripts/replay-test.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.65",
    "@ai-sdk/mcp": "^2.0.60",
    "@anthropic-ai/sdk": "^0.128.0",
    "@fastify/middie": "^9.3.4",
    "@fastify/static": "^10.1.5",
    "@playwright/mcp": "^0.0.82",
    "ai": "^7.0.116",
    "better-sqlite3": "12.11.1",
    "cheerio": "^1.2.0",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "nanoid": "^6.0.1",
    "p-limit": "^7.3.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "playwright": "1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
